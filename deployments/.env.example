
# ---- Bot de Telegram ----------------------------------------
# Obtener de @BotFather con /newbot
TELEGRAM_TOKEN=your_bot_token_here
# El chat ID donde llegan las alertas
# Consultar: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# ---- MySQL --------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=glpi
MYSQL_USER=glpi
MYSQL_PASSWORD=glpi

# ---- Red interna del honeypot -------------------------------
# Subred del bridge Docker (debe coincidir con docker-compose.yaml)
HONEYPOT_SUBNET=172.28.0.0/24

# ---- Zona horaria -------------------------------------------
TZ=Europe/Madrid
